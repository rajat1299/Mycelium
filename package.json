{
  "name": "computer-oss",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "build": "turbo run build",
    "db:down": "docker compose down",
    "db:push": "pnpm --filter @computer-oss/db db:push",
    "db:up": "docker compose up -d",
    "dev": "turbo run dev --parallel",
    "dev:control-plane": "pnpm --filter @computer-oss/control-plane dev",
    "dev:web": "pnpm --filter @computer-oss/web dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
